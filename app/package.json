{
  "name": "sharliz-tower",
  "version": "1.0.0",
  "private": true,
  "description": "Sharliz Tower - native app wrapper (Capacitor) around the web game in ../",
  "scripts": {
    "web": "cd .. && python3 tools/build.py --store",
    "assets": "npx capacitor-assets generate --iconBackgroundColor '#3a1a8a' --iconBackgroundColorDark '#3a1a8a' --splashBackgroundColor '#3a1a8a' --splashBackgroundColorDark '#3a1a8a'",
    "sync": "npx cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "cordova-plugin-purchase": "^13.12.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0"
  }
}
